# Servidor HTTP
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# Banco de Dados PostgreSQL 16 (Docker Compose)
POSTGRES_USER=produtividade
POSTGRES_PASSWORD=produtividade_secret
POSTGRES_DB=produtividade_db
DATABASE_URL="postgresql://produtividade:produtividade_secret@localhost:5432/produtividade_db?schema=public"

# Autenticação JWT (Épico 02)
JWT_ACCESS_SECRET=dev_jwt_access_secret_change_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# SMTP (Mailpit local)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Produtividade Pessoal <no-reply@produtividade.local>"

# Google Gemini API (Épico 08)
GEMINI_API_KEY=
